---
// CTA.astro
---

<section class="cta-section">
  <!-- IMAGEN DE FONDO CON OVERLAY OSCURO -->
  <div class="background-image-container">
    <img
      src="https://images.unsplash.com/photo-1565299585323-38d6b0865b47?q=80&w=1600&auto=format&fit=crop"
      alt="Fondo Los Rieles"
      class="bg-image"
    />
    <div class="overlay"></div>
  </div>

  <!-- CONTENIDO SOBRE LA IMAGEN -->
  <div class="container">
    <div class="content-box">
      <span class="subtitle">EL ANTOJO YA TE ENCONTRÓ</span>
      <h2 class="title">
        ¿Ya se te antojó? <span class="emoji">🌽</span>
      </h2>
      <p class="description">
        Tu próximo antojo está más cerca de lo que crees.
      </p>

      <!-- BOTONES DE ACCIÓN -->
      <div class="buttons-group">
        <a href="#menu" class="btn-primary">
          Ver menú <span>→</span>
        </a>
        <a
          href="https://wa.me/528617985462?text=Hola,%20busco%20m%C3%A1s%20informaci%C3%B3n%20para%20cotizar"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
            ></path>
          </svg>
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* --- CONTENEDOR Y POSICIONAMIENTO --- */
  .cta-section {
    position: relative;
    width: 100%;
    min-height: 480px;
    display: flex;
    align-items: center;
    background-color: #050505;
    color: #ffffff;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      sans-serif;
    overflow: hidden;
    padding: 4rem 1.25rem;
    box-sizing: border-box;
  }

  /* FONDO CON CAPA OSCURA */
  .background-image-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.6);
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(5, 5, 5, 0.95) 0%,
      rgba(5, 5, 5, 0.8) 45%,
      rgba(5, 5, 5, 0.4) 100%
    );
  }

  /* CONTENIDO PRINCIPAL */
  .container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
  }

  .content-box {
    max-width: 580px;
  }

  /* TIPOGRAFÍAS */
  .subtitle {
    color: #facc15;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.75rem;
  }

  .title {
    font-size: 2.75rem;
    font-weight: 900;
    margin: 0 0 1rem 0;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #ffffff;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .emoji {
    font-size: 2.25rem;
  }

  .description {
    color: #d4d4d8;
    font-size: 1rem;
    margin: 0 0 2rem 0;
    line-height: 1.5;
  }

  /* BOTONES DE ACCIÓN */
  .buttons-group {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    background-color: #facc15;
    color: #000000;
    font-weight: 800;
    font-size: 0.875rem;
    padding: 0.85rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .btn-primary:hover {
    background-color: #eab308;
    transform: translateY(-2px);
  }

  .btn-secondary {
    background-color: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-weight: 700;
    font-size: 0.875rem;
    padding: 0.85rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    backdrop-filter: blur(8px);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
  }

  /* --- ADAPTACIÓN A PANTALLAS GRANDES --- */
  @media (min-width: 768px) {
    .cta-section {
      min-height: 520px;
      padding: 5rem 2rem;
    }

    .title {
      font-size: 3.75rem;
    }

    .description {
      font-size: 1.125rem;
    }
  }

  /* ADAPTACIÓN EN MÓVILES PEQUEÑOS */
  @media (max-width: 480px) {
    .overlay {
      background: rgba(5, 5, 5, 0.88);
    }

    .buttons-group {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .btn-primary,
    .btn-secondary {
      justify-content: center;
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>
