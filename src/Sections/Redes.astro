---
// Contacto.astro
const redes = [
  {
    nombre: "WhatsApp",
    subtitulo: "Escríbenos",
    url: "https://wa.me/528617985462?text=Hola,%20busco%20m%C3%A1s%20informaci%C3%B3n%20para%20cotizar",
    activo: true,
    icono: "whatsapp"
  },
  {
    nombre: "Facebook",
    subtitulo: "Mantente al dia",
    url: "https://www.facebook.com/elotesrieles?locale=es_LA",
    activo: false,
    icono: "facebook"
  },
  {
    nombre: "Instagram",
    subtitulo: "Ve nuestro Contenido",
    url: "https://www.instagram.com/elotes_los_rieles/",
    activo: false,
    icono: "instagram"
  },
  {
    nombre: "Google Maps",
    subtitulo: "Cómo llegar",
    url: "https://maps.app.goo.gl/ZgebfaNLKMpLd61y8",
    activo: false,
    icono: "maps"
  }
];
---

<section class="contacto-section" id="contacto">
  <div class="container">
    
    <!-- COLUMNA IZQUIERDA: INFORMACIÓN Y TEXTOS -->
    <div class="info-column">
      <span class="subtitle">AQUÍ ESTAMOS</span>
      <h2 class="title">
        Conecta con <br />
        <span class="title-yellow">Los Rieles.</span>
      </h2>
      <p class="description">
        Síguenos, escríbenos o pasa por tu antojo favorito.
      </p>

      <div class="contact-details">
        <div class="detail-item">
          <svg class="detail-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span class="detail-text">Telefono: <strong>861 106 5398</strong></span>
        </div>

        <div class="detail-item">
          <svg class="detail-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span class="detail-text">Los Rieles —  Rivapalacio 26760, El Consuelo, 26760 Sabinas, Coah.</span>
        </div>
      </div>
    </div>

    <!-- COLUMNA DERECHA: TARJETAS DE REDES -->
    <div class="cards-column">
      {redes.map((item) => (
        <a href={item.url} class={`social-card ${item.activo ? 'card-active' : ''}`}>
          <div class="card-left">
            <div class="icon-wrapper">
              {item.icono === 'whatsapp' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
              )}
              {item.icono === 'facebook' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              )}
              {item.icono === 'instagram' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                </svg>
              )}
              {item.icono === 'maps' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="22" x2="11" y1="2" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              )}
            </div>

            <div class="text-group">
              <span class="social-name">{item.nombre}</span>
              <span class="social-sub">{item.subtitulo}</span>
            </div>
          </div>

          <span class="card-arrow">→</span>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  /* --- ESTILOS BASE Y CONTENEDOR --- */
  .contacto-section {
    background-color: #080808;
    color: #ffffff;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    padding: 5rem 1.25rem;
    width: 100%;
    box-sizing: border-box;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* --- COLUMNA IZQUIERDA --- */
  .info-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .subtitle {
    color: #facc15;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.75rem;
  }

  .title {
    font-size: 3rem;
    font-weight: 900;
    margin: 0 0 1rem 0;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #ffffff;
  }

  .title-yellow {
    color: #facc15;
  }

  .description {
    color: #888888;
    font-size: 1rem;
    margin: 0 0 2.5rem 0;
  }

  /* DATOS DE CONTACTO DE ABAJO */
  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .detail-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .detail-icon {
    color: #facc15;
    flex-shrink: 0;
  }

  .detail-text {
    color: #a1a1aa;
    font-size: 0.875rem;
  }

  .detail-text strong {
    color: #e4e4e7;
  }

  /* --- COLUMNA DERECHA: TARJETAS --- */
  .cards-column {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    width: 100%;
  }

  .social-card {
    background-color: #121214;
    border: 1px solid #222225;
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    color: #ffffff;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .social-card:hover {
    border-color: #333338;
    transform: translateY(-2px);
  }

  .card-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .icon-wrapper {
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* DESTACADO WHATSAPP AMARILLO */
  .card-active .icon-wrapper {
    color: #facc15;
  }

  .card-active .social-name {
    color: #facc15;
  }

  .card-active .card-arrow {
    color: #facc15;
  }

  .text-group {
    display: flex;
    flex-direction: column;
  }

  .social-name {
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .social-sub {
    color: #71717a;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .card-arrow {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 700;
    transition: transform 0.2s ease;
  }

  .social-card:hover .card-arrow {
    transform: translateX(3px);
  }

  /* --- ADAPTACIÓN A ESCRITORIO --- */
  @media (min-width: 900px) {
    .container {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 4rem;
    }

    .info-column {
      flex: 1;
      max-width: 480px;
    }

    .cards-column {
      flex: 1;
      grid-template-columns: repeat(2, 1fr);
      max-width: 620px;
    }

    .title {
      font-size: 4rem;
    }
  }
</style>