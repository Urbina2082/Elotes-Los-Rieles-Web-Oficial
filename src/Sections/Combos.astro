---
// Combos.astro
const combos = [
  {
    numero: "01",
    icono: "🌽",
    nombre: "Combo Clásico",
    items: ["Elote", "Bebida"],
    precio: "Consultar"
  },
  {
    numero: "02",
    icono: "🔥",
    nombre: "Combo Rielero",
    items: ["Fritos con elote", "Nachos", "Bebida"],
    precio: "Consultar"
  },
  {
    numero: "03",
    icono: "⭐",
    nombre: "Combo Los Rieles",
    items: ["Elote especial", "Botana", "Bebida", "Smoty's"],
    precio: "Consultar"
  }
];
---

<section class="combos-section">
  <div class="container">
    <!-- ENCABEZADO -->
    <div class="header">
      <span class="subtitle">PARA NO PENSARLO TANTO</span>
      <h2 class="title">Arma el antojo.</h2>
      <p class="description">
        Porque uno nunca es suficiente.
      </p>
    </div>

    <!-- REJILLA DE COMBOS -->
    <div class="combos-grid">
      {combos.map((combo) => (
        <div class="combo-card">
          <!-- NÚMERO SUPERIOR -->
          <span class="combo-number">{combo.numero}</span>

          <!-- ICONO Y NOMBRE -->
          <div class="combo-icon">{combo.icono}</div>
          <h3 class="combo-name">{combo.nombre}</h3>

          <!-- LISTA DE ELEMENTOS -->
          <ul class="combo-list">
            {combo.items.map((item) => (
              <li>
                <span class="yellow-bullet">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <!-- PIE DE TARJETA -->
          <div class="card-footer">
            <div class="price-box">
              <span class="price-label">Precio</span>
              <span class="price-value">{combo.precio}</span>
            </div>
            <a href="#" class="order-btn">
              Pedir combo <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* --- ESTILOS BASE Y CONTENEDOR --- */
  .combos-section {
    background-color: #080808;
    color: #ffffff;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    padding: 4rem 1.25rem 5rem 1.25rem;
    width: 100%;
    box-sizing: border-box;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* --- ENCABEZADO --- */
  .header {
    margin-bottom: 2.75rem;
  }

  .subtitle {
    color: #facc15;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
  }

  .title {
    font-size: 2.75rem;
    font-weight: 900;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .description {
    color: #888888;
    font-size: 0.95rem;
    margin: 0;
  }

  /* --- REJILLA Y TARJETAS --- */
  .combos-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .combo-card {
    background-color: #121214;
    border: 1px solid #222225;
    border-radius: 1rem;
    padding: 2.25rem 1.75rem 1.5rem 1.75rem;
    position: relative;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .combo-card:hover {
    border-color: #333338;
    transform: translateY(-3px);
  }

  .combo-number {
    position: absolute;
    top: 1.75rem;
    right: 1.75rem;
    color: #52525b;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .combo-icon {
    font-size: 1.75rem;
    margin-bottom: 1.25rem;
  }

  .combo-name {
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.02em;
  }

  /* LISTA CON VIÑETA AMARILLA */
  .combo-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .combo-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #d4d4d8;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .yellow-bullet {
    color: #facc15;
    font-size: 1.1rem;
    line-height: 1;
  }

  /* PIE DE TARJETA CON DIVISOR */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid #222225;
  }

  .price-box {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
  }

  .price-label {
    color: #71717a;
    font-weight: 500;
  }

  .price-value {
    color: #ffffff;
    font-weight: 700;
  }

  .order-btn {
    color: #facc15;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: opacity 0.2s ease;
  }

  .order-btn:hover {
    opacity: 0.8;
  }

  /* --- ADAPTACIÓN A ESCRITORIO --- */
  @media (min-width: 900px) {
    .title {
      font-size: 3.25rem;
    }

    .combos-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
</style>