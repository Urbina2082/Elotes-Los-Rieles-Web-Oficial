---
// PagoTransferencia.astro
const datosPago = {
  banco: "Santander",
  tarjeta: "5579 0890 0814 1056",
  titular: "IDALIA VILLARREAL",
};
---

<section class="pago-section" id="pago-transferencia">
  <div class="container">
    <!-- ENCABEZADO Y BANNER AMARILLO -->
    <div class="header">
      <span class="subtitle">MÉTODOS DE PAGO</span>
      <h2 class="title">Aceptamos Transferencias</h2>

      <div class="banner-amarillo">
        <span class="banner-text"
          >YA PUEDES REALIZAR TU PAGO POR TRANSFERENCIA</span
        >
      </div>
    </div>

    <!-- TARJETA BANCARIA ESTILO SANTANDER -->
    <div class="card-wrapper">
      <div class="credit-card">
        <!-- LOGO Y CONTACTLESS -->
        <div class="card-top">
          <div class="bank-brand">
            <span class="bank-name">{datosPago.banco}</span>
          </div>
          <div class="contactless-icon">
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>

        <div class="card-type-badge">
          <span>TARJETA</span>
        </div>

        <!-- NÚMERO DE TARJETA CON BOTÓN COPIAR -->
        <div class="card-number-box">
          <span class="card-number" id="num-tarjeta">{datosPago.tarjeta}</span>
          <button
            class="copy-btn"
            id="btn-copiar"
            title="Copiar número de tarjeta"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
              ></path>
            </svg>
            <span id="copiar-texto">Copiar</span>
          </button>
        </div>

        <!-- NOMBRE DEL TITULAR -->
        <div class="card-holder-box">
          <span class="holder-label">A NOMBRE DE:</span>
          <span class="holder-name">{datosPago.titular}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // FUNCIONALIDAD PARA COPIAR EL NÚMERO DE TARJETA CON UN CLIC
  document.addEventListener("DOMContentLoaded", () => {
    const btnCopiar = document.getElementById("btn-copiar");
    const numTarjeta = document.getElementById("num-tarjeta");
    const copiarTexto = document.getElementById("copiar-texto");

    if (btnCopiar && numTarjeta && copiarTexto) {
      btnCopiar.addEventListener("click", () => {
        const textoLimpio = numTarjeta.innerText.replace(/\s+/g, "");
        navigator.clipboard.writeText(textoLimpio).then(() => {
          copiarTexto.innerText = "¡Copiado!";
          btnCopiar.classList.add("copiado");

          setTimeout(() => {
            copiarTexto.innerText = "Copiar";
            btnCopiar.classList.remove("copiado");
          }, 2000);
        });
      });
    }
  });
</script>

<style>
  /* --- ESTILOS BASE --- */
  .pago-section {
    background-color: #080808;
    color: #ffffff;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      sans-serif;
    padding: 4rem 1.25rem;
    width: 100%;
    box-sizing: border-box;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  /* --- ENCABEZADO --- */
  .header {
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .subtitle {
    color: #facc15;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
  }

  .title {
    font-size: 2.25rem;
    font-weight: 900;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  /* BANNER AMARILLO DESTACADO */
  .banner-amarillo {
    background-color: #facc15;
    color: #000000;
    padding: 0.85rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 900;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    display: inline-block;
    box-shadow: 0 4px 20px rgba(250, 204, 21, 0.2);
    max-width: 90%;
  }

  /* --- CONTENEDOR TARJETA ROJA --- */
  .card-wrapper {
    display: flex;
    justify-content: center;
    padding: 0.5rem;
  }

  .credit-card {
    background: linear-gradient(135deg, #b91c1c 0%, #881337 100%);
    border: 2px solid #ef4444;
    border-radius: 1.5rem;
    padding: 2rem 1rem;
    width: 100%;
    max-width: 520px;
    box-shadow: 0 20px 40px rgba(185, 28, 28, 0.35);
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    box-sizing: border-box;
  }

  /* CABECERA TARJETA (BANCO + CONTACTLESS) */
  .card-top {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .bank-brand {
    font-size: 1.75rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
    font-style: italic;
  }

  /* ICONO CONTACTLESS ONDAS */
  .contactless-icon {
    display: flex;
    gap: 3px;
    align-items: center;
  }

  .contactless-icon span {
    border: 2px solid rgba(255, 255, 255, 0.8);
    border-left: none;
    border-top: none;
    border-bottom: none;
    border-radius: 0 50% 50% 0;
    display: block;
  }

  .contactless-icon span:nth-child(1) {
    height: 12px;
    width: 4px;
  }
  .contactless-icon span:nth-child(2) {
    height: 18px;
    width: 6px;
  }
  .contactless-icon span:nth-child(3) {
    height: 24px;
    width: 8px;
  }

  /* BADGE TARJETA */
  .card-type-badge {
    background-color: #ffffff;
    color: #000000;
    font-size: 0.65rem;
    font-weight: 900;
    padding: 0.25rem 0.85rem;
    border-radius: 1rem;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  /* NÚMERO DE TARJETA CON BOTÓN */
  .card-number-box {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.75rem;
    padding: 1rem;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    box-sizing: border-box;
  }

  .card-number {
    font-family: "Courier New", Courier, monospace;
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.08em;
    word-break: break-all;
  }

  /* BOTÓN COPIAR */
  .copy-btn {
    background-color: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.4rem 0.85rem;
    border-radius: 0.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 0.2s ease;
  }

  .copy-btn:hover {
    background-color: #ffffff;
    color: #b91c1c;
  }

  .copy-btn.copiado {
    background-color: #22c55e;
    border-color: #22c55e;
    color: #ffffff;
  }

  /* TITULAR DE LA TARJETA */
  .card-holder-box {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .holder-label {
    font-size: 0.65rem;
    font-weight: 800;
    color: #facc15;
    letter-spacing: 0.15em;
    margin-bottom: 0.25rem;
  }

  .holder-name {
    font-size: 1.25rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: 0.05em;
  }

  /* --- RESPONSIVO PARA ESCRITORIO --- */
  @media (min-width: 640px) {
   
    .title {
      font-size: 2.75rem;
    }

    .banner-amarillo {
      font-size: 1rem;
    }

    .card-number-box {
      flex-direction: row;
      justify-content: space-between;
      padding: 1rem 1.25rem;
    }

    .card-number {
      font-size: 1.5rem;
    }

    .holder-name {
      font-size: 1.4rem;
    }
  }
</style>
