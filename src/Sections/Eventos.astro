  //   caracteristicas: [
  //     "Servicio de elotes",
  //     "Esquites",
  //     "Toppings básicos",
  //     "Preparación en el lugar",
  //     "Personal de servicio"
  //   ],
  //   destacado: false,
  //   textoBoton: "Cotizar paquete →"
  // },
  {
    icono: "🔥",
    badge: "MÁS PEDIDO",
    nombre: "Paquete a la Medida",
    descripcion: "Diseñado 100% según tus necesidades y número de invitados.",
    caracteristicas: [
      "Menú personalizable",
      "Atención a cualquier volumen",
      "Servicio completo / Staff dedicado",
      "Montaje y mobiliario incluido",
      "Asesoría inmediata"
    ],
    destacado: true,
    textoBoton: "Cotizar paquete →"
  },
  // {
  //   icono: "⭐",
  //   badge: null,
  //   nombre: "Paquete Los Rieles",
  //   descripcion: "La experiencia completa.",
  //   caracteristicas: [
  //     "Elotes, esquites y nachos",
  //     "Botanas, rusas y Smoty's",
  //     "Bebidas y toppings",
  //     "Servicio en el evento",
  //     "Presentación especial"
  //   ],
  //   destacado: false,
  //   textoBoton: "Quiero este paquete →"
  // }
];
---

<section class="eventos-section" id="eventos">
  <div class="container">
    <!-- ENCABEZADO -->
    <div class="header">
      <div class="header-left">
        <span class="subtitle">PARA CELEBRAR JUNTOS</span>
        <h2 class="title">Lleva los Elotes a tu evento.</h2>
        <p class="description">
          ¿Tienes un cumpleaños, fiesta, reunión o evento especial? Nosotros llevamos el sabor hasta donde estés.
        </p>
      </div>
      <div class="header-right">
        <a href="https://wa.me/528611089151?text=Hola,%20busco%20m%C3%A1s%20informaci%C3%B3n%20para%20cotizar" class="btn-main">Cotizar mi evento →</a>
      </div>
    </div>

    <!-- REJILLA DE PAQUETES -->
    <div class="paquetes-grid">
      {paquetes.map((pkg) => (
        <div class={`card ${pkg.destacado ? 'card-destacada' : 'card-normal'}`}>
          {pkg.badge && <span class="badge">{pkg.badge}</span>}
          
          <div class="card-icon">{pkg.icono}</div>
          <h3 class="card-title">{pkg.nombre}</h3>
          <p class="card-desc">{pkg.descripcion}</p>

          <ul class="features-list">
            {pkg.caracteristicas.map((item) => (
              <li>
                <span class="check">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="card-footer">
            <div class="price-info">
              <span class="price-label">Cotización</span>
              <span class="price-val">personalizada</span>
            </div>
            <a href="https://wa.me/528617985462?text=Hola,%20busco%20m%C3%A1s%20informaci%C3%B3n%20para%20cotizar" class="card-btn">{pkg.textoBoton}</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<!-- Para más información y cotizaciones:

[ 💬 861 798 5462 ] -> Enlace: https://wa.me/528617985462?text=Hola,%20busco%20m%C3%A1s%20informaci%C3%B3n%20para%20cotizar
[ 💬 861 108 9151 ] -> Enlace: https://wa.me/528611089151?text=Hola,%20busco%20m%C3%A1s%20informaci%C3%B3n%20para%20cotizar -->
<style>
  /* --- ESTILOS BASE Y CONTENEDOR --- */
  .eventos-section {
    background-color: #facc15;
    color: #000000;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    padding: 4rem 1.25rem 5rem 1.25rem;
    width: 100%;
    box-sizing: border-box;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* --- ENCABEZADO --- */
  .header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .subtitle {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
    color: rgba(0, 0, 0, 0.6);
  }

  .title {
    font-size: 2.75rem;
    font-weight: 900;
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #000000;
  }

  .description {
    color: rgba(0, 0, 0, 0.7);
    font-size: 1rem;
    margin: 0;
    max-width: 520px;
    line-height: 1.5;
  }

  .btn-main {
    background-color: #0a0a0a;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.875rem;
    padding: 0.85rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    display: inline-block;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .btn-main:hover {
    background-color: #1a1a1a;
    transform: translateY(-2px);
  }

  /* --- REJILLA DE PAQUETES --- */
  .paquetes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  /* --- ESTILOS DE LAS TARJETAS --- */
  .card {
    border-radius: 1.25rem;
    padding: 2.25rem 2rem 1.75rem 2rem;
    position: relative;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease;
  }

  .card:hover {
    transform: translateY(-4px);
  }

  /* TARJETA CLARA (NORMAL) */
  .card-normal {
    background-color: #fef08a;
    color: #1c1917;
  }

  .card-normal .card-title {
    color: #000000;
  }

  .card-normal .card-desc {
    color: #71717a;
  }

  .card-normal .features-list li {
    color: #3f3f46;
  }

  .card-normal .check {
    color: #a1a1aa;
  }

  .card-normal .card-btn {
    color: #000000;
  }

  /* TARJETA OSCURA (DESTACADA) */
  .card-destacada {
    background-color: #141414;
    color: #ffffff;
    box-shadow: 0 20px 35px -5px rgba(0, 0, 0, 0.3);
  }

  .card-destacada .card-title {
    color: #ffffff;
  }

  .card-destacada .card-desc {
    color: #a1a1aa;
  }

  .card-destacada .features-list li {
    color: #d4d4d8;
  }

  .card-destacada .check {
    color: #facc15;
  }

  .card-destacada .card-btn {
    color: #facc15;
  }

  /* ELEMENTOS INTERNOS DE LA TARJETA */
  .badge {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background-color: #facc15;
    color: #000000;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.35rem 0.65rem;
    border-radius: 0.375rem;
    letter-spacing: 0.05em;
  }

  .card-icon {
    font-size: 1.75rem;
    margin-bottom: 1.25rem;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0 0 0.35rem 0;
    letter-spacing: -0.02em;
  }

  .card-desc {
    font-size: 0.875rem;
    margin: 0 0 1.75rem 0;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex-grow: 1;
  }

  .features-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .check {
    font-size: 0.85rem;
    font-weight: 700;
  }

  /* PIE DE TARJETA */
  .card-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .card-destacada .card-footer {
    border-top-color: rgba(255, 255, 255, 0.1);
  }

  .price-info {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .price-val {
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .card-btn {
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .card-btn:hover {
    opacity: 0.75;
  }

  /* --- ADAPTACIÓN A PANTALLAS GRANDES (RESPONSIVE) --- */
  @media (min-width: 900px) {
    .header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .paquetes-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .title {
      font-size: 3.5rem;
    }
  }
</style>