---
const whatsapp = "https://wa.me/528611089151?text=Hola,%20busco%20m%C3%A1s%20informaci%C3%B3n%20para%20cotizar";
---

<section class="hero">

  <!-- =========================
       NAVBAR
  ========================== -->

  <header class="navbar">

    <a href="/" class="brand">
      <img
        src="/logo_.avif"
        alt="Los Rieles"
        class="brand-logo"
      />

      <span>LOS RIELES</span>
    </a>


    <!-- NAV DESKTOP -->

    <nav class="nav-links" id="navLinks">

      <a href="#menu">Menú</a>
      <a href="#ubicacion">Ubicación</a>
      <!-- <a href="#combos">Combos</a> -->
      <a href="#eventos">Eventos</a>
      <a href="#contacto">Contacto</a>

      <a
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="whatsapp-nav"
      >
        <span class="whatsapp-icon"></span>
        WhatsApp
      </a>

    </nav>


    <!-- HAMBURGUESA -->

    <button
      class="menu-toggle"
      id="menuToggle"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </header>


  <!-- =========================
       HERO
  ========================== -->

  <main class="hero-content">

    <div class="hero-left">

      <!-- EYEBROW -->

      <div class="eyebrow">
        <span></span>
        <p>25 AÑOS HACIENDO HISTORIA</p>
      </div>


      <!-- LOGO -->

      <div class="hero-logo">
        <img
          src="/logo_.avif"
          alt="Elotes Los Rieles"
        />
      </div>


      <!-- TITULO -->

      <h1>
        Un tren de sabor
        <strong>
          que siempre se te
          <br class="desktop" />
          antoja.
        </strong>
      </h1>


      <!-- DESCRIPCIÓN -->

      <p class="description">
        Elotes, snacks, bebidas y mucho sabor para compartir.
      </p>


      <!-- BOTONES -->

      <div class="hero-buttons">

        <a href="#menu" class="primary-button">
          🌽 Ver menú
          <span>→</span>
        </a>

        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="secondary-button"
        >
          <span class="chat-icon"></span>
         Cotizar Evento
        </a>

      </div>


      <!-- CARACTERÍSTICAS -->

      <div class="features">

        <div class="feature">
          <span class="star">★</span>
          <span>Sabor que nos distingue</span>
        </div>

        <div class="feature">
          <span class="dot yellow"></span>
          <span>25 años de tradición</span>
        </div>

        <div class="feature">
          <span class="dot red"></span>
          <span>Hecho para compartir</span>
        </div>

      </div>

    </div>


    <!-- TEXTO LATERAL -->

    <div class="scroll-indicator">

      <span>
        DESLIZA PARA ANTOJARTE
      </span>

      <b>↓</b>

    </div>


    <!-- INDICADOR -->

    <div class="hero-indicator">
      <span></span>
    </div>

  </main>

</section>


<style>

  /* =====================================
     RESET
  ===================================== */

  .hero,
  .hero *,
  .hero *::before,
  .hero *::after {
    box-sizing: border-box;
  }


  .hero {
    --yellow: #ffd400;
    --yellow-hover: #ffdf28;

    position: relative;

    width: 100%;
    height: 100dvh;
    min-height: 620px;

    overflow: hidden;

    color: white;

    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, .91) 0%,
        rgba(0, 0, 0, .72) 35%,
        rgba(0, 0, 0, .42) 75%,
        rgba(0, 0, 0, .48) 100%
      ),
      linear-gradient(
        0deg,
        rgba(0, 0, 0, .55),
        rgba(0, 0, 0, .10)
      ),
      url("/desktop.avif");

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }


  /* =====================================
     NAVBAR
  ===================================== */

  .navbar {

    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 78px;

    padding: 0 clamp(20px, 5vw, 70px);

    display: flex;
    align-items: center;
    justify-content: space-between;

    background: rgba(5, 5, 5, .78);

    border-bottom: 1px solid rgba(255,255,255,.07);

    z-index: 100;
  }


  /* =====================================
     BRAND
  ===================================== */

  .brand {

    display: flex;
    align-items: center;

    gap: 12px;

    color: white;

    text-decoration: none;

    white-space: nowrap;
  }


  .brand-logo {

    width: 45px;
    height: 45px;

    border-radius: 50%;

    object-fit: cover;

    background: white;
  }


  .brand span {

    font-size: 15px;

    font-weight: 700;

    letter-spacing: 2px;
  }


  /* =====================================
     NAV DESKTOP
  ===================================== */

  .nav-links {

    display: flex;
    align-items: center;

    gap: clamp(15px, 2vw, 32px);

    min-width: 0;
  }


  .nav-links a {

    color: rgba(255,255,255,.72);

    text-decoration: none;

    font-size: 14px;

    white-space: nowrap;

    transition: .25s ease;
  }


  .nav-links a:hover {

    color: white;
  }


  /* =====================================
     WHATSAPP NAV
  ===================================== */

  .whatsapp-nav {

    display: flex;
    align-items: center;

    gap: 9px;

    padding: 10px 17px;

    border: 1px solid rgba(255,212,0,.8);

    border-radius: 999px;

    color: var(--yellow) !important;

    font-weight: 600;
  }


  .whatsapp-icon {

    width: 16px;
    height: 16px;

    border: 2px solid currentColor;

    border-radius: 50%;

    position: relative;
  }


  .whatsapp-icon::after {

    content: "";

    position: absolute;

    bottom: -4px;
    left: 0;

    width: 5px;
    height: 5px;

    border-left: 2px solid currentColor;

    transform: rotate(-30deg);
  }


  /* =====================================
     HERO CONTENT
  ===================================== */

  .hero-content {

    width: min(100%, 1450px);

    height: 100%;

    margin: 0 auto;

    padding:
      115px
      clamp(25px, 5vw, 70px)
      70px;

    display: flex;
    align-items: center;

    position: relative;
  }


  .hero-left {

    width: min(700px, 100%);
  }


  /* =====================================
     EYEBROW
  ===================================== */

  .eyebrow {

    display: flex;
    align-items: center;

    gap: 12px;

    margin-bottom: 13px;
  }


  .eyebrow span {

    width: 34px;
    height: 3px;

    background: var(--yellow);
  }


  .eyebrow p {

    margin: 0;

    color: var(--yellow);

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 2.5px;
  }


  /* =====================================
     LOGO
  ===================================== */

  .hero-logo {

    width: 110px;
    height: 110px;

    margin-bottom: 12px;

    background: white;

    display: flex;
    align-items: center;
    justify-content: center;
  }


  .hero-logo img {

    width: 100%;
    height: 100%;

    object-fit: contain;
  }


  /* =====================================
     TITULO
  ===================================== */

  h1 {

    margin: 0;

    font-size: clamp(48px, 5vw, 76px);

    line-height: .94;

    letter-spacing: -3px;

    font-weight: 800;
  }


  h1 strong {

    display: block;

    color: var(--yellow);

    font-weight: 800;
  }


  /* =====================================
     DESCRIPTION
  ===================================== */

  .description {

    margin: 23px 0 0;

    max-width: 560px;

    color: rgba(255,255,255,.73);

    font-size: 17px;

    line-height: 1.4;
  }


  /* =====================================
     BUTTONS
  ===================================== */

  .hero-buttons {

    display: flex;
    align-items: center;

    gap: 13px;

    margin-top: 27px;
  }


  .hero-buttons a {

    text-decoration: none;
  }


  .primary-button {

    min-height: 52px;

    padding: 0 22px;

    display: flex;
    align-items: center;

    gap: 28px;

    background: var(--yellow);

    color: #050505;

    border-radius: 7px;

    font-size: 15px;

    font-weight: 700;

    transition: .25s ease;
  }


  .primary-button:hover {

    background: var(--yellow-hover);

    transform: translateY(-2px);
  }


  .primary-button span {

    font-size: 22px;
  }


  .secondary-button {

    min-height: 52px;

    padding: 0 20px;

    display: flex;
    align-items: center;

    gap: 10px;

    color: white;

    background: rgba(255,255,255,.035);

    border: 1px solid rgba(255,255,255,.25);

    border-radius: 7px;

    backdrop-filter: blur(8px);

    font-size: 15px;

    font-weight: 600;

    transition: .25s ease;
  }


  .secondary-button:hover {

    background: rgba(255,255,255,.09);
  }


  .chat-icon {

    width: 17px;
    height: 17px;

    border: 2px solid white;

    border-radius: 50%;
  }


  /* =====================================
     FEATURES
  ===================================== */

  .features {

    display: flex;
    align-items: center;

    gap: 25px;

    margin-top: 31px;
  }


  .feature {

    display: flex;
    align-items: center;

    gap: 8px;

    color: rgba(255,255,255,.67);

    font-size: 12px;

    white-space: nowrap;
  }


  .star {

    color: var(--yellow);

    font-size: 17px;
  }


  .dot {

    width: 8px;
    height: 8px;

    border-radius: 50%;
  }


  .yellow {
    background: var(--yellow);
  }


  .red {
    background: #ed1c24;
  }


  /* =====================================
     SCROLL LATERAL
  ===================================== */

  .scroll-indicator {

    position: absolute;

    right: 25px;
    bottom: 35px;

    display: flex;
    flex-direction: column;
    align-items: center;

    gap: 12px;
  }


  .scroll-indicator span {

    writing-mode: vertical-rl;

    transform: rotate(180deg);

    color: rgba(255,255,255,.45);

    font-size: 9px;

    letter-spacing: 2px;
  }


  .scroll-indicator b {

    color: var(--yellow);

    font-size: 22px;

    font-weight: 400;
  }


  /* =====================================
     INDICADOR CENTRAL
  ===================================== */

  .hero-indicator {

    position: absolute;

    bottom: 27px;
    left: 50%;

    transform: translateX(-50%);

    width: 30px;
    height: 48px;

    border-radius: 20px;

    background: rgba(77,91,119,.55);

    display: flex;
    justify-content: center;

    padding-top: 9px;
  }


  .hero-indicator span {

    width: 4px;
    height: 13px;

    border-radius: 10px;

    background: rgba(255,255,255,.18);
  }


  /* =====================================
     HAMBURGUESA
  ===================================== */

  .menu-toggle {

    display: none;

    width: 42px;
    height: 42px;

    padding: 8px;

    border: 1px solid rgba(255,255,255,.18);

    border-radius: 8px;

    background: transparent;

    cursor: pointer;
  }


  .menu-toggle span {

    display: block;

    width: 100%;
    height: 2px;

    margin: 5px 0;

    background: white;

    transition: .25s ease;
  }


  /* =====================================
     TABLET
  ===================================== */

  @media (max-width: 1100px) {

    .nav-links {
      gap: 14px;
    }

    .nav-links a {
      font-size: 12px;
    }

    .whatsapp-nav {
      padding: 9px 13px;
    }

    .hero-content {
      padding-left: 45px;
      padding-right: 45px;
    }

    h1 {
      font-size: clamp(46px, 6vw, 65px);
    }

  }


  /* =====================================
     MOBILE
  ===================================== */

  @media (max-width: 768px) {

    .hero {

      height: 100dvh;

      min-height: 600px;

      background:
        linear-gradient(
          180deg,
          rgba(0,0,0,.58),
          rgba(0,0,0,.88)
        ),
        url("/mobile.avif");

      background-position: 60% center;
      background-size: cover;
    }


    /* NAVBAR */

    .navbar {

      height: 70px;

      padding: 0 18px;
    }


    .brand {

      gap: 9px;
    }


    .brand-logo {

      width: 40px;
      height: 40px;
    }


    .brand span {

      font-size: 13px;

      letter-spacing: 1.5px;
    }


    /* OCULTAR NAV DESKTOP */

    .nav-links {

      display: none;
    }


    /* MOSTRAR HAMBURGUESA */

    .menu-toggle {

      display: block;
    }


    /* HERO */

    .hero-content {

      width: 100%;

      height: 100%;

      padding:
        95px
        20px
        70px;

      align-items: center;
    }


    .hero-left {

      width: 100%;
    }


    /* EYEBROW */

    .eyebrow {

      margin-bottom: 10px;
    }


    .eyebrow span {

      width: 25px;
    }


    .eyebrow p {

      font-size: 9px;

      letter-spacing: 1.7px;
    }


    /* LOGO */

    .hero-logo {

      width: 82px;
      height: 82px;

      margin-bottom: 13px;
    }


    /* TITULO */

    h1 {

      font-size: clamp(42px, 12vw, 58px);

      letter-spacing: -2px;

      line-height: .95;
    }


    .desktop {
      display: none;
    }


    /* DESCRIPTION */

    .description {

      margin-top: 18px;

      font-size: 15px;

      max-width: 330px;
    }


    /* BUTTONS */

    .hero-buttons {

      margin-top: 22px;

      width: 100%;

      flex-direction: column;

      align-items: stretch;

      gap: 9px;
    }


    .primary-button,
    .secondary-button {

      width: 100%;

      min-height: 48px;

      justify-content: center;
    }


    /* FEATURES */

    .features {

      margin-top: 20px;

      gap: 10px 17px;

      flex-wrap: wrap;
    }


    .feature {

      font-size: 10px;
    }


    /* QUITAR INDICADOR LATERAL */

    .scroll-indicator {

      display: none;
    }


    .hero-indicator {

      bottom: 15px;

      width: 25px;
      height: 40px;
    }


    /* MENU ABIERTO */

    .nav-links.mobile-open {

      position: absolute;

      top: 70px;
      left: 0;

      width: 100%;

      padding: 12px 20px 20px;

      display: flex;

      flex-direction: column;

      align-items: stretch;

      gap: 0;

      background: rgba(5,5,5,.97);

      backdrop-filter: blur(15px);

      border-bottom: 1px solid rgba(255,255,255,.08);

      z-index: 200;
    }


    .nav-links.mobile-open a {

      padding: 14px 5px;

      border-bottom: 1px solid rgba(255,255,255,.07);

      font-size: 14px;
    }


    .nav-links.mobile-open .whatsapp-nav {

      margin-top: 12px;

      justify-content: center;

      border: 1px solid var(--yellow);
    }

  }


  /* =====================================
     CELULARES MUY PEQUEÑOS
  ===================================== */

  @media (max-width: 380px) {

    .hero-content {

      padding-top: 90px;
    }


    .hero-logo {

      width: 70px;
      height: 70px;
    }


    h1 {

      font-size: 39px;
    }


    .description {

      font-size: 14px;
    }


    .features {

      display: none;
    }

  }

</style>


<script>

  const menuToggle =
    document.querySelector("#menuToggle");

  const navLinks =
    document.querySelector("#navLinks");


  menuToggle?.addEventListener("click", () => {

    const isOpen =
      navLinks?.classList.toggle("mobile-open");


    menuToggle?.setAttribute(
      "aria-expanded",
      String(isOpen)
    );

  });

</script>